# Copy this file to .env and paste your key. .env is gitignored.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# OpenRouter — Jev is available here today, no waitlist.
# Get a key at https://openrouter.ai/settings/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Which Jev to call through OpenRouter. Ignored on the TypeSafe direct path,
# which names its models differently.
#   typesafe/jev-1.13            floating, tracks the 1.13 line
#   typesafe/jev-1.13-20260917   pinned build, reproducible
JEV_MODEL=typesafe/jev-1.13

# Override the decisions endpoint. Only needed if OpenRouter moves it out of
# alpha; the verified default is https://openrouter.ai/api/alpha/decisions
# JEV_DECISIONS_URL=

# ---------------------------------------------------------------------------
# TypeSafe direct — only if your early-access key has arrived.
# Takes precedence over OPENROUTER_API_KEY when set.
# ---------------------------------------------------------------------------
# TYPESAFE_API_KEY=

# Which Jev to call through TypeSafe directly. Separate from JEV_MODEL because
# the namespaces differ: `jev-latest` here, `typesafe/jev-1.13` on OpenRouter.
# TYPESAFE_MODEL=jev-latest
